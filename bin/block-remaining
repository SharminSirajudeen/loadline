#!/usr/bin/env python3
"""Minutes left in the current Claude 5-hour usage window, and when it opened.

The window is rolling: it starts at your first request when no window is
active, and runs five hours from that moment. It is NOT aligned to clock
hours. Flooring the start to the hour (as at least one popular tool does)
reports the reset up to 59 minutes early — telling you that you are about to
be throttled when you are not.

The bias this file exists to avoid runs the other way too. A transcript stamp
records when a message LANDED, not when its request was SENT, so taking the
first message after a rollover as the new window's start places it late, and
late means claiming time you do not have. When usage runs right up to a
rollover the next window opens AT the boundary, so that is what we use;
only a real idle gap moves the start to the first message after it.

Reads every profile on this machine, since the window is per account.

Prints "4h 21m @15:52" so the estimate can be checked against /usage rather
than trusted. Cached for 60s; reads transcripts touched in the last 11 hours.

MEASURED against /usage on 2026-09-08: this said 4h 11m when the truth was
4h 0m. The gap was not a bug in the maths. The window had opened ten minutes
before ANY local transcript stamp, because cloud sessions, claude.ai and the
mobile app bill the same account and write nothing to ~/.claude/projects.

That error can only ever run one way: unseen usage makes the window look
younger than it is, never older. So this is an UPPER BOUND, printed with a
leading "<=" so it is never mistaken for the real number. Check /usage when
it matters.
"""
import json, glob, os, re, time, datetime, sys

CACHE = "/tmp/.loadline-block"
# Survives reboots and /tmp cleaning, unlike the 60s cache.
ANCHOR = os.path.expanduser("~/.claude/.loadline-anchor")
WINDOW = 5 * 3600
# A gap longer than this across a rollover is a real break, not continuous use.
IDLE = 15 * 60

def compute():
    now = time.time()
    stamps = []
    # Every profile on this machine, not just the default one. The usage window
    # is per account, so a session run under ~/.claude-work counts against the
    # same five hours and used to be invisible here.
    roots = ["~/.claude/projects", "~/.claude-work/projects"]
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        roots.append(os.path.join(os.environ["CLAUDE_CONFIG_DIR"], "projects"))
    files = []
    for r in roots:
        files.extend(glob.glob(os.path.join(os.path.expanduser(r), "*", "*.jsonl")))
    for f in set(files):
        try:
            if os.path.getmtime(f) < now - 11 * 3600:
                continue
            with open(f, errors="ignore") as fh:
                for line in fh:
                    i = line.find('"timestamp":"')
                    if i < 0:
                        continue
                    s = line[i + 13:i + 37]
                    try:
                        stamps.append(datetime.datetime.fromisoformat(
                            s.replace("Z", "+00:00")).timestamp())
                    except ValueError:
                        pass
        except OSError:
            continue
    if not stamps:
        return None
    stamps.sort()
    start = None
    last = None
    for t in stamps:
        if start is None:
            start = t
        elif t >= start + WINDOW:
            # The old window lapsed. If work was still going as it lapsed, the
            # next request landed on the boundary and that is where the new
            # window opened — using this message's stamp instead would push the
            # start late and overstate what is left. A real idle gap is
            # different: there the window genuinely opened at this message.
            boundary = start + WINDOW
            start = boundary if (last is not None and t - last <= IDLE) else t
        last = t
    return start

def read_anchor():
    """The last /usage reading you gave us, with its age.

    Deliberately NOT extrapolated. The counter does not track the wall clock,
    so subtracting elapsed time would invent precision we do not have. Showing
    the reading and its age is the whole truth available.
    """
    try:
        a = json.load(open(ANCHOR))
    except Exception:
        return None
    age = time.time() - a["set_at"]
    if age > 3 * 3600:          # older than this and it tells you nothing
        return None
    return a


if len(sys.argv) > 1 and sys.argv[1] == "--anchor":
    # Teach it the truth: block-remaining --anchor "3h 56m"   (from /usage)
    text = " ".join(sys.argv[2:])
    m = re.search(r"(?:(\d+)\s*hr?)?\D*(\d+)\s*min", text) or re.search(r"(?:(\d+)h )?(\d+)m", text)
    if not m:
        print('usage: block-remaining --anchor "3 hr 56 min"', file=sys.stderr)
        sys.exit(2)
    # /usage reports whole minutes, almost certainly floored: "3 hr 56 min"
    # means somewhere in [3:56:00, 3:57:00). Take the midpoint so the anchor
    # is centred rather than pinned to the earliest possible instant, which
    # would make every later reading a minute short.
    remaining = (int(m.group(1) or 0) * 60 + int(m.group(2))) * 60
    # Store the READING, not a derived start time. Three readings taken minutes
    # apart showed the counter falling faster than the wall clock (8 minutes
    # lost over 6m33s of real time), so `start + WINDOW - now` cannot produce
    # it and no start time exists to store.
    json.dump({"remaining": remaining, "set_at": time.time()}, open(ANCHOR, "w"))
    print(f"recorded: {int(remaining//3600)}h {int(remaining%3600//60)}m "
          f"as of {datetime.datetime.now().strftime('%H:%M')}")
    print("read /usage immediately before running this: the anchor is only as "
          "fresh as the number you gave it, and a stale reading places the "
          "start late, which is the very error this exists to remove.",
          file=sys.stderr)
    sys.exit(0)

anchored = read_anchor()
if anchored:
    r = anchored["remaining"]
    print(f"{int(r//3600)}h {int(r%3600//60)}m as of "
          f"{datetime.datetime.fromtimestamp(anchored['set_at']).strftime('%H:%M')}")
    sys.exit(0)

try:
    st = json.load(open(CACHE))
    if time.time() - st["at"] < 60:
        start = st["start"]
    else:
        raise ValueError
except Exception:
    start = compute()
    try:
        json.dump({"at": time.time(), "start": start}, open(CACHE, "w"))
    except OSError:
        pass

if not start:
    sys.exit(0)
# Round, do not floor. Flooring loses up to 59 seconds and made this read a
# minute below /usage for most of every minute.
secs = start + WINDOW - time.time()
if secs < 0:
    sys.exit(0)
left = int(round(secs / 60))
span = f"{left//60}h {left%60}m" if left >= 60 else f"{left}m"
# "<=" because usage this machine cannot see only ever shortens the real
# window. Overstating time left is the one error that gets you throttled
# mid-thought, so the bound leans the safe way and says which way it leans.
# The start time is the whole point: it makes the number falsifiable at a
# glance. If it says 15:52 and you know you were working at 15:41, the tool
# has told on itself.
# No "<=" when anchored: you gave us the real number, so this one is real.
lead = "<="
print(f"{lead}{span} @{datetime.datetime.fromtimestamp(start).strftime('%H:%M')}")
